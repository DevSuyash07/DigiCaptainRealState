# ---------------------------------------------------------------------------
# Frontend env vars (Vite). Sirf VITE_ prefix wale hi browser bundle me jaate
# hain, isliye yahan koi secret na rakhein.
# ---------------------------------------------------------------------------

# Backend ka base URL. Local dev me khali chhod dein (vite proxy /api ko
# localhost:5000 par bhej deta hai).
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Phone OTP — Firebase Phone Authentication (free tier, DLT approval ki zarurat
# nahi). Ye chaar values set hone par OTP seedha browser se Firebase bhejta hai
# aur asli phone par SMS aata hai. Values Firebase Console →
# Project settings → Your apps → Web app config me milti hain.
#
# Firebase Console me ye do cheezein bhi chahiye:
#   1. Authentication → Sign-in method → Phone = Enabled
#   2. Authentication → Settings → Authorised domains me site ka domain
#      (e.g. digi-captain-real-state.vercel.app) add ho
#
# In char ke bina component purane backend route (/api/v1/auth/phone-otp/*)
# par chala jaata hai — koi mock OTP nahi hai.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional (Firebase config inhe deta hai; phone auth inke bina bhi chalta hai)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
