# Copy this file to real-estate-backend/.env for local work, and set the same
# names in the Vercel project that serves the API. .env itself is gitignored -
# never commit a real value, and never paste one into a chat.
#
# Every name below is read somewhere in src/. The "required" block is the
# difference between the API answering JSON and the API answering 500.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# MySQL 8 connection string (PlanetScale, Railway, Aiven, Hostinger, your own).
# prisma/schema/main.prisma -> datasource db { provider = "mysql" }
DATABASE_URL="mysql://user:password@host:3306/dbname"

# Long random strings, different from each other. src/controllers/auth.controller.js
# and src/middlewares/authMiddleware.js sign/verify with these.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Single fallback used only when the two above are missing.
# JWT_SECRET=

# ---------------------------------------------------------------------------
# PRODUCTION BEHAVIOUR
# ---------------------------------------------------------------------------

NODE_ENV=production

# The site's exact origin, no trailing slash. Used by the CORS allow-list in
# src/app.js and by the password-reset link in auth.controller.js.
FRONTEND_URL=https://your-site.vercel.app

# Auth cookies. Site and API on different domains = cross-site, which needs
# SameSite=None + Secure. Left unset, src/utils/cookieOptions.js picks 'none'
# in production and 'lax' in development, which is what you want.
# COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.yourdomain.com

# Token lifetimes (defaults shown).
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# PROPERTY PHOTOS - src/config/cloudinary.js
# Without these, the image-upload route fails; the rest of the API is fine.
# ---------------------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# EMAIL OTP AND PASSWORD RESET - src/utils/email.js (SMTP via nodemailer)
# ---------------------------------------------------------------------------

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ---------------------------------------------------------------------------
# PHONE OTP OVER SMS - src/utils/sendSms.js (Twilio)
# If these are missing the OTP route answers 503 with the missing names. It
# never reports an SMS as sent when none was sent.
# ---------------------------------------------------------------------------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Local development only: print the OTP to the server log instead of sending an
# SMS. Must never be set in production.
# USE_MOCK_SMS=true
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_SECONDS=30
# DEFAULT_COUNTRY_CODE=+91
# PHONE_TOKEN_EXPIRES_IN=15m

# Local only - Vercel assigns its own port.
PORT=5000
